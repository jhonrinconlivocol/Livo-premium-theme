<section class="lp-offer-section lp-section">

  <div class="lp-container">

    <div class="lp-section-heading">

      {% if product.metafields.custom.offer_title != blank %}
        <h2>
          {{ product.metafields.custom.offer_title }}
        </h2>
      {% endif %}

      {% if product.metafields.custom.offer_subtitle != blank %}
        <p>
          {{ product.metafields.custom.offer_subtitle }}
        </p>
      {% endif %}

    </div>

    {% if product.metafields.custom.offer_featured != blank
      or product.metafields.custom.offer_featured_text != blank %}

      <div class="lp-featured-offer">

        <div class="lp-featured-offer__label">
          ⭐ Oferta más elegida
        </div>

        {% if product.metafields.custom.offer_featured != blank %}
          <div class="lp-featured-offer__title">
            {{ product.metafields.custom.offer_featured }}
          </div>
        {% endif %}

        {% if product.metafields.custom.offer_featured_text != blank %}
          <div class="lp-featured-offer__text">
            {{ product.metafields.custom.offer_featured_text }}
          </div>
        {% endif %}

      </div>

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "LP Offer",
  "settings": [],
  "presets": [
    {
      "name": "LP Offer"
    }
  ]
}
{% endschema %}
