<section class="lp-benefits-section lp-section">

  <div class="lp-container">

    <div class="lp-section-heading">

      <h2>
        Diseñado para ayudarte a sentirte mejor cada día
      </h2>

      <p>
        Una solución enfocada en bienestar, confianza y calidad.
      </p>

    </div>

    {% assign benefits = product.metafields.custom.benefits.value %}

    {% if benefits != blank %}

      <div class="lp-benefits-grid">

        {% for benefit in benefits %}

          <div class="lp-benefit-card">

            <div class="lp-benefit-icon">
              ✓
            </div>

            <h3>
              Beneficio {{ forloop.index }}
            </h3>

            <p>
              {{ benefit }}
            </p>

          </div>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "LP Benefits",
  "settings": [],
  "presets": [
    {
      "name": "LP Benefits"
    }
  ]
}
{% endschema %}
