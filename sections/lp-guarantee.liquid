<section class="lp-guarantee-section lp-section">

  <div class="lp-container">

    <div class="lp-guarantee-card">

      <div class="lp-guarantee-icon">
        🛡️
      </div>

      <h2>
        {% if product.metafields.custom.guarantee_title != blank %}
          {{ product.metafields.custom.guarantee_title }}
        {% else %}
          Compra con tranquilidad
        {% endif %}
      </h2>

      <p class="lp-guarantee-text">

        {% if product.metafields.custom.guarantee_text != blank %}
          {{ product.metafields.custom.guarantee_text }}
        {% else %}
          Queremos que tengas la mejor experiencia posible. Por eso trabajamos con productos de calidad, envíos seguros y atención personalizada durante todo el proceso.
        {% endif %}

      </p>

      <div class="lp-guarantee-features">

        <div class="lp-guarantee-feature">
          ✓ Atención al cliente
        </div>

        <div class="lp-guarantee-feature">
          ✓ Envíos a toda Colombia
        </div>

        <div class="lp-guarantee-feature">
          ✓ Pago contra entrega disponible
        </div>

        <div class="lp-guarantee-feature">
          ✓ Compra protegida
        </div>

      </div>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "LP Guarantee",
  "settings": [],
  "presets": [
    {
      "name": "LP Guarantee"
    }
  ]
}
{% endschema %}
