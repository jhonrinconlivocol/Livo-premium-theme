<section class="lp-home-hero">

  <div class="lp-container">

      <div class="lp-home-hero__content">

            <span class="lp-badge">
                    Bienestar • Confianza • Resultados
                          </span>

                                <h1>
                                        Soluciones reales para ayudarte a sentirte mejor cada día
                                              </h1>

                                                    <p class="lp-home-hero__subtitle">
                                                            Descubre productos cuidadosamente seleccionados para apoyar tu bienestar,
                                                                    rendimiento físico y confianza personal.
                                                                          </p>

                                                                                <div class="lp-home-hero__actions">

                                                                                        <a href="/collections/all" class="lp-btn lp-btn-primary">
                                                                                                  Ver Soluciones
                                                                                                          </a>

                                                                                                                  <a href="#beneficios" class="lp-btn lp-btn-secondary">
                                                                                                                            Conocer Más
                                                                                                                                    </a>

                                                                                                                                          </div>

                                                                                                                                                <div class="lp-home-hero__trust">

                                                                                                                                                        <span>{{ settings.trust_message_1 }}</span>

                                                                                                                                                                <span>{{ settings.trust_message_2 }}</span>

                                                                                                                                                                        <span>{{ settings.trust_message_3 }}</span>

                                                                                                                                                                              </div>

                                                                                                                                                                                  </div>

                                                                                                                                                                                      <div class="lp-home-hero__image">

                                                                                                                                                                                            {% comment %}
                                                                                                                                                                                                  Imagen principal Home Hero
                                                                                                                                                                                                        Subir posteriormente desde Shopify
                                                                                                                                                                                                              {% endcomment %}

                                                                                                                                                                                                                    <div class="lp-home-hero__placeholder">

                                                                                                                                                                                                                            HERO IMAGE

                                                                                                                                                                                                                                  </div>

                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                        </section>

                                                                                                                                                                                                                                        {% schema %}
                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                              "name": "Home Hero",
                                                                                                                                                                                                                                                "settings": []
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                        {% endschema %}
                                                                                                                                                                                                                                        }