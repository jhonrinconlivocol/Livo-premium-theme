<section
  id="lp-product-form"
  class="lp-product-form-section lp-section"
>

  <div class="lp-container">

```
<div class="lp-product-layout">

  <!-- GALERÍA -->

  <div class="lp-product-gallery-column">

    {% render 'product-gallery' %}

  </div>

  <!-- INFO -->

  <div class="lp-product-info-column">

    <h2 class="lp-product-title">
      {{ product.title }}
    </h2>

    {% render 'product-price' %}

    {% render 'trust-badges' %}

    <!-- OFERTAS -->

    <div class="lp-bundle-selector">

      <h3 class="lp-bundle-title">
        Selecciona tu oferta
      </h3>

      <div class="lp-bundle-options">

        {% for variant in product.variants %}

          <label
            class="
              lp-bundle-option
              {% if variant.title contains 'Paga 2 Lleva 3' %}
                lp-bundle-best
              {% endif %}
              {% if variant.title contains 'Paga 3 Lleva 5' %}
                lp-bundle-hot
              {% endif %}
            "
          >

            <input
              type="radio"
              name="id"
              value="{{ variant.id }}"
              {% if forloop.first %}
                checked
              {% endif %}
            >

            <div class="lp-bundle-content">

              <div class="lp-bundle-name">
                {{ variant.title }}
              </div>

              <div class="lp-bundle-price">
                {{ variant.price | money }}
              </div>

            </div>

          </label>

        {% endfor %}

      </div>

    </div>

    {% render 'buy-buttons' %}

  </div>

</div>
```

  </div>

</section>

