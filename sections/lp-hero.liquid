<section class="lp-product-hero lp-section">

  <div class="lp-container">

    <div class="lp-product-hero__grid">

      <!-- GALERÍA -->
      <div class="lp-product-hero__gallery">
        {% render 'product-gallery', product: product %}
      </div>

      <!-- INFORMACIÓN -->
      <div class="lp-product-hero__content">

        {% if product.metafields.custom.landing_badge != blank %}
          <div class="lp-badge">
            {{ product.metafields.custom.landing_badge }}
          </div>
        {% endif %}

        <h1 class="lp-product-title">
          {% if product.metafields.custom.landing_title != blank %}
            {{ product.metafields.custom.landing_title }}
          {% else %}
            {{ product.title }}
          {% endif %}
        </h1>

        {% if product.metafields.custom.landing_subtitle != blank %}
          <p class="lp-product-subtitle">
            {{ product.metafields.custom.landing_subtitle }}
          </p>
        {% endif %}

        <!-- PRECIO -->
        {% render 'product-price', product: product %}

        <!-- FORMULARIO -->
        <product-form>

          {% form 'product', product %}

            {% render 'buy-buttons', product: product %}

          {% endform %}

        </product-form>

        <!-- BADGES -->
        {% render 'trust-badges' %}

      </div>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "LP Hero",
  "settings": [],
  "presets": [
    {
      "name": "LP Hero"
    }
  ]
}
{% endschema %}
