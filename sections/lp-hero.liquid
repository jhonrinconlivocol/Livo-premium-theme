<section class="lp-product-hero lp-section">

  <div class="lp-container">

      <div class="lp-product-hero__grid">

            <!-- GALERÍA -->

                  <div class="lp-product-hero__gallery">

                          {% render 'product-gallery', product: product %}

                                </div>

                                      <!-- INFORMACIÓN -->

                                            <div class="lp-product-hero__content">

                                                    <div class="lp-badge">
                                                              ⭐ Oferta Premium
                                                                      </div>

                                                                              <h1 class="lp-product-title">
                                                                                        {{ product.title }}
                                                                                                </h1>

                                                                                                        <p class="lp-product-subtitle">

                                                                                                                  {% if product.description != blank %}
                                                                                                                              {{ product.description | strip_html | truncatewords: 25 }}
                                                                                                                                        {% else %}
                                                                                                                                                    Descubre una solución diseñada para ayudarte a alcanzar tus objetivos de bienestar.
                                                                                                                                                              {% endif %}

                                                                                                                                                                      </p>

                                                                                                                                                                              <!-- BENEFICIOS -->

                                                                                                                                                                                      <div class="lp-product-benefits">

                                                                                                                                                                                                <div class="lp-product-benefit">
                                                                                                                                                                                                            ✔ Resultados visibles con uso constante
                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                <div class="lp-product-benefit">
                                                                                                                                                                                                                                            ✔ Fórmula de alta calidad
                                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                                                <div class="lp-product-benefit">
                                                                                                                                                                                                                                                                            ✔ Envío rápido a toda Colombia
                                                                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                                                                                <div class="lp-product-benefit">
                                                                                                                                                                                                                                                                                                            ✔ Pago contra entrega disponible
                                                                                                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                                                                                                              </div>

                                                                                                                                                                                                                                                                                                                                      <!-- PRECIO -->

                                                                                                                                                                                                                                                                                                                                              {% render 'product-price', product: product %}

                                                                                                                                                                                                                                                                                                                                                      <!-- OFERTA DESTACADA -->

                                                                                                                                                                                                                                                                                                                                                              <div class="lp-featured-offer">

                                                                                                                                                                                                                                                                                                                                                                        <div class="lp-featured-offer__label">
                                                                                                                                                                                                                                                                                                                                                                                    ⭐ Oferta más elegida
                                                                                                                                                                                                                                                                                                                                                                                              </div>

                                                                                                                                                                                                                                                                                                                                                                                                        <div class="lp-featured-offer__title">
                                                                                                                                                                                                                                                                                                                                                                                                                    Paga 2 y Lleva 3
                                                                                                                                                                                                                                                                                                                                                                                                                              </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                        <div class="lp-featured-offer__text">
                                                                                                                                                                                                                                                                                                                                                                                                                                                    Obtén más producto por menos dinero y maximiza tu inversión.
                                                                                                                                                                                                                                                                                                                                                                                                                                                              </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <!-- FORMULARIO -->

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <product-form>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {% form 'product', product %}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {% render 'buy-buttons', product: product %}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      {% endform %}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </product-form>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <!-- BADGES -->

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              {% render 'trust-badges' %}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </section>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          {% schema %}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              "name": "LP Hero",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "settings": [],
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  "presets": [
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  "name": "LP Hero"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  ]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          {% endschema %}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
