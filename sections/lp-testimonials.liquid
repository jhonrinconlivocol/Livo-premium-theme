<section class="lp-testimonials-section lp-section">

  <div class="lp-container">

    <div class="lp-section-heading">
      <h2>Lo que dicen nuestros clientes</h2>
      <p>Experiencias reales de personas que ya probaron el producto.</p>
    </div>

    {% assign testimonials = product.metafields.custom.testimonios.value %}

    {% if testimonials != blank %}

      <div class="lp-testimonials-grid">

        {% for item in testimonials %}

          <div class="lp-testimonial-card">

            {% if item.foto != blank %}
              <div class="lp-testimonial-image">
                <img
                  src="{{ item.foto | image_url: width: 200 }}"
                  alt="{{ item.nombre }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              </div>
            {% endif %}

            {% if item.calificacion != blank %}
              <div class="lp-stars">

                {% assign stars = item.calificacion | plus: 0 %}

                {% for i in (1..stars) %}
                  ★
                {% endfor %}

              </div>
            {% endif %}

            {% if item.testimonio != blank %}
              <div class="lp-testimonial-text">
                {{ item.testimonio | metafield_tag }}
              </div>
            {% endif %}

            {% if item.nombre != blank %}
              <div class="lp-testimonial-author">
                {{ item.nombre }}
              </div>
            {% endif %}

            {% if item.ciudad != blank %}
              <div class="lp-testimonial-meta">
                {{ item.ciudad }}
              </div>
            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "LP Testimonials",
  "settings": [],
  "presets": [
    {
      "name": "LP Testimonials"
    }
  ]
}
{% endschema %}
