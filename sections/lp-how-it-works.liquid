<section class="lp-how-it-works-section lp-section">

  <div class="lp-container">

    <div class="lp-section-heading">
      <h2>¿Cómo funciona?</h2>
      <p>Sigue estos sencillos pasos.</p>
    </div>

    {% assign steps = product.metafields.custom.how_it_works.value %}

    {% if steps != blank %}

      <div class="lp-how-it-works-grid">

        {% for step in steps %}

          <div class="lp-how-it-works-card">

            {% if step.step_icon != blank %}
              <div class="lp-how-it-works-icon">
                {{ step.step_icon }}
              </div>
            {% endif %}

            {% if step.step_title != blank %}
              <h3>
                {{ step.step_title }}
              </h3>
            {% endif %}

            {% if step.step_description != blank %}
              <p>
                {{ step.step_description }}
              </p>
            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "LP How It Works",
  "settings": [],
  "presets": [
    {
      "name": "LP How It Works"
    }
  ]
}
{% endschema %}
