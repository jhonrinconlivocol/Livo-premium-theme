<section class="lp-how-it-works-section lp-section">

  <div class="lp-container">

    {% assign step = product.metafields.custom.how_it_works.value %}

    <h2>Prueba How It Works</h2>

    <p>Título: {{ step.titulo }}</p>

    <p>Descripción: {{ step.descripcion }}</p>

