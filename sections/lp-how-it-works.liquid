<section class="lp-how-it-works-section lp-section">

  <div class="lp-container">

    <div class="lp-section-heading">
      <h2>¿Cómo funciona?</h2>
      <p>Sigue estos sencillos pasos.</p>
    </div>

    {% assign steps = product.metafields.custom.lp_how_it_works.value %}

    {% if steps != blank %}

      <div class="lp-how-it-works-grid">

        {% for step in steps %}

          <div class="lp-how-it-works-card">

            {% if step.icono != blank %}
              <div class="lp-how-it-works-icon">
                {{ step.icono }}
              </div>
            {% endif %}

            {% if step.titulo != blank %}
              <h3 class="lp-how-it-works-title">
                {{ step.titulo }}
              </h3>
            {% endif %}

            {% if step.descripcion != blank %}
              <div class="lp-how-it-works-description">
                {{ step.descripcion | metafield_tag }}
              </div>
            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "LP How It Works",
  "settings": [],
  "presets": [
    {
      "name": "LP How It Works"
    }
  ]
}
{% endschema %}
