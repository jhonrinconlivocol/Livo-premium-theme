<section class="lp-faq-section lp-section">

  <div class="lp-container">

    <div class="lp-section-heading">
      <h2>Preguntas frecuentes</h2>
      <p>Resolvemos las dudas más comunes antes de tu compra.</p>
    </div>

    {% assign faqs = product.metafields.custom.faqs.value %}

    {% if faqs != blank %}

      <div class="lp-faq-list">

        {% for faq in faqs %}

          <details class="lp-faq-item" {% if forloop.first %}open{% endif %}>

            <summary class="lp-faq-question">
              {{ faq.pregunta }}
            </summary>

            <div class="lp-faq-answer">
              {{ faq.respuesta | metafield_tag }}
            </div>

          </details>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "LP FAQ",
  "settings": [],
  "presets": [
    {
      "name": "LP FAQ"
    }
  ]
}
{% endschema %}
