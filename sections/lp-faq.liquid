{% assign faqs = product.metafields.custom.faq_producto.value %}

{% if faqs != blank %}

<div class="lp-faq">

  {% for faq in faqs %}

    <details class="lp-faq-item" {% if forloop.first %}open{% endif %}>
      <summary>{{ faq.pregunta }}</summary>

      <div class="lp-faq-answer">
        {{ faq.respuesta }}
      </div>

    </details>

  {% endfor %}

</div>

{% endif %}
