<section class="lp-final-cta-section lp-section">

  <div class="lp-container">

    <div class="lp-final-cta-card">

      <h2>
        {% if product.metafields.custom.final_cta_title != blank %}
          {{ product.metafields.custom.final_cta_title }}
        {% else %}
          Da el siguiente paso hoy
        {% endif %}
      </h2>

      <p class="lp-final-cta-text">

        {% if product.metafields.custom.final_cta_text != blank %}
          {{ product.metafields.custom.final_cta_text }}
        {% else %}
          Miles de clientes ya han elegido una alternativa enfocada en calidad, confianza y bienestar. Aprovecha las promociones disponibles y recibe tu pedido en la puerta de tu casa.
        {% endif %}

      </p>

      <div class="lp-final-cta-points">

        <div class="lp-final-cta-point">
          ✓ Envíos a toda Colombia
        </div>

        <div class="lp-final-cta-point">
          ✓ Pago contra entrega disponible
        </div>

        <div class="lp-final-cta-point">
          ✓ Compra segura
        </div>

      </div>

      <a href="#lp-product-form" class="lp-button">
        Quiero aprovechar la oferta
      </a>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "LP Final CTA",
  "settings": [],
  "presets": [
    {
      "name": "LP Final CTA"
    }
  ]
}
{% endschema %}
